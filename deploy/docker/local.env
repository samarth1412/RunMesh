RUNMESH_HTTP_ADDR=:8080
RUNMESH_GRPC_ADDR=:7001
RUNMESH_DATABASE_URL=postgres://runmesh:runmesh@postgres:5432/runmesh?sslmode=disable
RUNMESH_KAFKA_BROKERS=redpanda:9092
RUNMESH_KAFKA_TOPIC=runmesh.tasks
RUNMESH_INTERNAL_TOKEN=local-development-token
RUNMESH_LEASE_DURATION=30s
RUNMESH_SCHEDULER_INTERVAL=500ms
RUNMESH_OUTBOX_INTERVAL=250ms
RUNMESH_DEV_AUTH=false
RUNMESH_DEV_TENANT_ID=00000000-0000-0000-0000-000000000001
RUNMESH_DEV_USER_ID=00000000-0000-0000-0000-000000000001
RUNMESH_DEV_ROLE=admin
RUNMESH_OIDC_ISSUER=http://localhost:8180/realms/runmesh
RUNMESH_OIDC_JWKS_URL=http://keycloak:8080/realms/runmesh/protocol/openid-connect/certs
RUNMESH_OIDC_AUDIENCE=runmesh-web
RUNMESH_OIDC_TENANT_CLAIM=runmesh_tenant_id
RUNMESH_API_KEY_PEPPER=local-development-pepper
RUNMESH_REDIS_URL=redis://redis:6379/0
RUNMESH_RATE_LIMIT_RATE=100
RUNMESH_RATE_LIMIT_BURST=200
RUNMESH_RATE_LIMIT_FAIL_OPEN=false
OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4317
